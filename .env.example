# Copy to .env for local development. Defaults below match docker-compose.yml.
# Staging/prod values are set in Vercel per environment. Nothing secret is prefixed NEXT_PUBLIC_.

# --- Database (Postgres in Docker locally; Neon in staging/prod) ---
# App connection. On Neon, use the pooled connection string.
DATABASE_URL=postgres://profyle:profyle@localhost:5433/profyle
# Migrations (drizzle-kit). On Neon, use the direct (unpooled) connection string.
DATABASE_URL_UNPOOLED=postgres://profyle:profyle@localhost:5433/profyle
# Integration tests only.
TEST_DATABASE_URL=postgres://profyle:profyle@localhost:5433/profyle_test

# --- Domains ---
# Apex the app is served on. Public portfolios live at {handle}.{NEXT_PUBLIC_ROOT_DOMAIN}.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# --- Auth (Better Auth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
# Public origin of the app (apex only; sessions never reach handle subdomains).
BETTER_AUTH_URL=http://localhost:3000
# OAuth apps are per environment. Leave blank to hide that sign-in button (email codes still work).
# GitHub callback: {BETTER_AUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google callback: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Image storage (S3 API: RustFS locally, Cloudflare R2 in staging/prod) ---
# R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=http://localhost:9000
# R2: auto
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=profyle
S3_SECRET_ACCESS_KEY=profyle-secret
S3_BUCKET=profyle
# Public base URL for objects under users/*. R2: https://pub-<hash>.r2.dev
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/profyle

# --- Email (Mailpit locally; Resend's SMTP relay in staging/prod) ---
# Resend: host smtp.resend.com, port 465, user "resend", pass = API key
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Profyle <no-reply@profyle.io>"
